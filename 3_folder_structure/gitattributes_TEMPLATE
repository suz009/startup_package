# ============================================================
# .gitattributes — Git LFS configuration template
# Tracks large data/binary files via Git LFS so the regular
# git history stays small.
#
# Install steps (one-time per machine):
#   git lfs install
#
# Then commit this .gitattributes:
#   git add .gitattributes && git commit -m "Configure Git LFS"
#
# To track a new pattern later:
#   git lfs track "*.parquet"
#   (which appends to this file)
# ============================================================

# ---- Pipeline data outputs ----
1_data/**/*.json filter=lfs diff=lfs merge=lfs -text
1_data/**/*.jsonl filter=lfs diff=lfs merge=lfs -text
1_data/**/*.parquet filter=lfs diff=lfs merge=lfs -text
1_data/**/*.feather filter=lfs diff=lfs merge=lfs -text
1_data/**/*.pkl filter=lfs diff=lfs merge=lfs -text
1_data/**/*.h5 filter=lfs diff=lfs merge=lfs -text

# ---- Archived / current snapshots ----
1_data/0_current/*.json filter=lfs diff=lfs merge=lfs -text
1_data/99_archive/**/*.json filter=lfs diff=lfs merge=lfs -text

# ---- Reports / visualizations (large HTML/PDF) ----
3_analysis/**/*.html filter=lfs diff=lfs merge=lfs -text
3_analysis/**/*.pdf filter=lfs diff=lfs merge=lfs -text

# ---- Background reading materials ----
0_context/background/*.pdf filter=lfs diff=lfs merge=lfs -text
0_context/background/*.epub filter=lfs diff=lfs merge=lfs -text

# ---- Common large binary formats ----
*.zip filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
